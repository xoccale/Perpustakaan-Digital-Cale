{
  "version": 2,
  "builds": [
    { "src": "vercel/index.php", "use": "vercel-php@0.8.0" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "^(.*)$", "dest": "/vercel/index.php?__vercel_path=$1" }
  ]
}
